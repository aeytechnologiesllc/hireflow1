{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hireflow-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8080
    },
    {
      "name": "hireflow-dev-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "vite", "--port", "5183", "--strictPort"],
      "port": 5183
    },
    {
      "name": "design-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "design/preview", "-l", "4321", "--no-clipboard"],
      "port": 4321
    },
    {
      "name": "landing-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "public", "-l", "4502", "--no-clipboard"],
      "port": 4502
    }
  ]
}
