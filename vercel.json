{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://yqklrkpptnhubsnijqze.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/jobs.xml",
      "destination": "/api/job-feed"
    },
    {
      "source": "/adzuna.xml",
      "destination": "/api/job-feed-adzuna"
    },
    {
      "source": "/jooble.xml",
      "destination": "/api/job-feed-jooble"
    },
    {
      "source": "/candidate/job/:id",
      "destination": "/api/job-prerender?id=:id"
    },
    {
      "source": "/job/:id",
      "destination": "/api/job-prerender?id=:id"
    },
    {
      "source": "/careers",
      "destination": "/api/careers-prerender?home=1"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/careers-prerender?slug=:slug"
    },
    {
      "source": "/c/:business/:slug",
      "destination": "/api/job-prerender?business=:business&slug=:slug"
    },
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|Viber|SkypeUriPreview|Googlebot|Google-InspectionTool|GoogleOther|bingbot|Applebot|Pinterestbot|Pinterest/|redditbot|Snapchat|snapchat|Embedly|Iframely).*"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "staff.hireflownow.com"
        }
      ],
      "destination": "/api/job-prerender?slug=:slug"
    },
    {
      "source": "/:path+",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "staff.hireflownow.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
